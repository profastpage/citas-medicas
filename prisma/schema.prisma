// ============================================================
// CitasPro SaaS — Schema Multi-tenant
// Fusiona el stack de MenuPro (auth, billing, planes, multi-tenant)
// con el dominio médico del sistema PHP de citas.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE SAAS (reutilizable para otros nichos)
// ============================================================

/// Usuario autenticado (dueño de clínica, admin, médico, recepcionista)
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  fullName        String
  phone           String?
  avatarUrl       String?
  role            String   @default("owner") // owner | super_admin | doctor | receptionist
  plan            String   @default("free")  // free | pro | premium | full
  mpPreapprovalId String?
  mpStatus        String?
  currentPeriodEnd DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ownedClinics    Clinic[] @relation("OwnedClinics")
  memberships     ClinicMember[]
  auditLogs       AuditLog[]
}

/// Clínica = organización multi-tenant (cada cliente SaaS puede tener 1 o varias)
model Clinic {
  id              String   @id @default(cuid())
  ownerId         String
  name            String
  slug            String   @unique
  ruc             String?
  address         String?
  phone           String?
  email           String?
  logoUrl         String?
  currency        String   @default("S/")
  themeColor      String   @default("#0ea5e9")
  brandingText    String   @default("Gestionado con CitasPro")
  isWhiteLabel    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation("OwnedClinics", fields: [ownerId], references: [id], onDelete: Cascade)
  members         ClinicMember[]
  specialties     Specialty[]
  services        Service[]
  doctors         Doctor[]
  patients        Patient[]
  appointments    Appointment[]
  schedules       DoctorSchedule[]
  payments        Payment[]
  cashSessions    CashSession[]
  medications     Medication[]
  auditLogs       AuditLog[]
  files           PatientFile[]
}

/// Membresías de usuarios en clínicas (multi-rol)
model ClinicMember {
  id          String   @id @default(cuid())
  userId      String
  clinicId    String
  role        String   // owner | doctor | receptionist | admin
  invitedAt   DateTime @default(now())
  acceptedAt  DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
}

// ============================================================
// DOMINIO MÉDICO (extraído del sistema PHP)
// ============================================================

/// Especialidades médicas (Cardiología, Pediatría, etc.)
model Specialty {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctors     Doctor[]
  interconsults Interconsult[]

  @@unique([clinicId, name])
}

/// Servicios médicos (Consulta, Electrocardiograma, etc.) con precio
model Service {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  description String?
  price       Float
  durationMin Int      @default(30) // duración por defecto en minutos
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([clinicId, name])
}

/// Médico vinculado a un usuario y a una clínica
model Doctor {
  id             String   @id @default(cuid())
  clinicId       String
  userId         String?
  specialtyId    String
  fullName       String
  documentId     String?  // DNI / colegiatura
  colegiatura    String?
  phone          String?
  email          String?
  bio            String?
  consultationPrice Float?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  specialty      Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  schedules      DoctorSchedule[]
  appointments   Appointment[]

  @@index([clinicId])
  @@index([specialtyId])
}

/// Horarios de atención por médico y día de la semana
model DoctorSchedule {
  id           String   @id @default(cuid())
  clinicId     String
  doctorId     String
  dayOfWeek    String   // Lunes | Martes | Miércoles | Jueves | Viernes | Sábado | Domingo
  specificDate DateTime? // si está seteado, aplica solo a esa fecha
  startTime    String   // "08:00"
  endTime      String   // "18:00"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
}

/// Paciente (datos demográficos + historia clínica)
model Patient {
  id                  String   @id @default(cuid())
  clinicId            String
  firstName           String
  lastName            String
  fullName            String
  documentType        String?  // DNI | CE | Pasaporte
  documentId          String?
  birthDate           DateTime?
  sex                 String?  // M | F | Otro
  phone               String?
  email               String?
  address             String?
  bloodType           String?  // O+ | O- | A+ | ...
  allergies           String?
  chronicConditions   String?
  medicalHistory      String?  // antecedentes
  emergencyContact    String?
  emergencyPhone      String?
  medicalRecordNumber String?  // N° historia clínica
  notes               String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clinic              Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  files               PatientFile[]

  @@index([clinicId])
  @@index([clinicId, documentId])
  @@index([clinicId, lastName])
}

/// Cita médica + datos de atención clínica (historia)
model Appointment {
  id                  String   @id @default(cuid())
  clinicId            String
  patientId           String
  doctorId            String
  serviceId           String?
  appointmentDate     DateTime
  durationMin         Int      @default(30)
  reason              String?  // motivo de consulta
  status              String   @default("pendiente") // pendiente | confirmada | en_atencion | finalizada | cancelada | no_asistio
  notes               String?

  // ── Signos vitales ──
  weight              Float?   // peso (kg)
  height              Float?   // talla (cm)
  temperature         Float?   // °C
  bloodPressure       String?  // "120/80"
  heartRate           String?  // fc
  respiratoryRate     String?  // fr
  oxygenSaturation    String?  // sat O2

  // ── Historia clínica ──
  illnessDuration     String?  // tiempo de enfermedad
  currentIllness      String?  // enfermedad actual
  background          String?  // antecedentes
  physicalExam        String?  // examen físico
  auxiliaryExams      String?  // exámenes auxiliares
  diagnosis           String?  // diagnóstico
  treatment           String?  // tratamiento
  prescription        String?  // prescripción
  restDays            Int      @default(0)
  restEndDate         DateTime?
  followUpDate        DateTime? // fecha de control

  interconsultSpecialtyId String? // interconsulta a especialidad

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clinic              Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient             Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor              Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service             Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  payments            Payment[]
  interconsults       Interconsult[]

  @@index([clinicId, appointmentDate])
  @@index([doctorId, appointmentDate])
  @@index([patientId])
}

/// Interconsultas derivadas desde una cita
model Interconsult {
  id              String   @id @default(cuid())
  appointmentId   String
  specialtyId     String
  notes           String?
  createdAt       DateTime @default(now())

  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  specialty       Specialty   @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
}

// ============================================================
// CAJA Y PAGOS
// ============================================================

/// Pago asociado a una cita
model Payment {
  id              String   @id @default(cuid())
  clinicId        String
  appointmentId   String
  amount          Float
  method          String   // efectivo | tarjeta | yape | plin | transferencia
  reference       String?
  notes           String?
  paymentDate     DateTime @default(now())

  clinic          Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([clinicId, paymentDate])
  @@index([appointmentId])
}

/// Sesión de caja (apertura / cierre) por usuario
model CashSession {
  id              String   @id @default(cuid())
  clinicId        String
  openedByUserId  String
  openingAmount   Float    @default(0)
  closingAmount   Float?
  openedAt        DateTime @default(now())
  closedAt        DateTime?
  status          String   @default("abierta") // abierta | cerrada
  notes           String?
  expenses        CashExpense[]

  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
}

/// Gastos registrados durante una sesión de caja
model CashExpense {
  id              String   @id @default(cuid())
  cashSessionId   String
  description     String
  amount          Float
  expenseDate     DateTime @default(now())

  cashSession     CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
}

// ============================================================
// INVENTARIO MÉDICO
// ============================================================

/// Medicamentos / insumos
model Medication {
  id              String   @id @default(cuid())
  clinicId        String
  commercialName  String
  genericName     String?
  presentation    String?  // tableta | jarabe | inyectable | ...
  stock           Int      @default(0)
  minStock        Int      @default(5)
  unitPrice       Float?
  expiryDate      DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, commercialName])
}

// ============================================================
// ARCHIVOS ADJUNTOS DE PACIENTES
// ============================================================

/// Archivos PDF/imágenes subidos a la historia del paciente
model PatientFile {
  id              String   @id @default(cuid())
  clinicId        String
  patientId       String
  fileName        String
  fileUrl         String
  fileType        String?  // pdf | jpg | png | ...
  fileSize        Int?
  description     String?
  uploadedAt      DateTime @default(now())

  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// ============================================================
// AUDITORÍA Y SEGURIDAD
// ============================================================

/// Log de auditoría multi-tenant
model AuditLog {
  id              String   @id @default(cuid())
  clinicId        String?
  userId          String?
  action          String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT
  entity          String?  // tabla afectada
  entityId        String?
  description     String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  clinic          Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([userId])
}
