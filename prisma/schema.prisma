// ============================================================
// CitasPro SaaS — Schema Multi-tenant (PostgreSQL / Supabase)
// Fusiona el stack de MenuPro (auth, billing, planes, multi-tenant)
// con el dominio médico del sistema PHP de citas.
//
// Migrado de SQLite a PostgreSQL para producción en Supabase.
// RLS policies se aplican vía SQL aparte (supabase/rls-policies.sql).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// CORE SAAS (reutilizable para otros nichos)
// ============================================================

/// Usuario autenticado (dueño de clínica, admin, médico, recepcionista)
/// El auth real lo hace Supabase Auth; este modelo es el perfil de negocio.
/// `supabaseUid` es el UUID que Supabase Auth asigna al crear el usuario.
model User {
  id               String    @id @default(cuid())
  supabaseUid      String    @unique @map("supabase_uid") // UUID de auth.users en Supabase
  email            String    @unique
  passwordHash     String    @default("") @map("password_hash") // legacy: ya no se usa con Supabase Auth, se mantiene por compat
  fullName         String    @map("full_name")
  phone            String?
  avatarUrl        String?   @map("avatar_url")
  role             String    @default("owner") // owner | super_admin | doctor | receptionist
  plan             String    @default("free") // free | pro | premium | full
  mpPreapprovalId  String?   @map("mp_preapproval_id")
  mpStatus         String?   @map("mp_status")
  currentPeriodEnd DateTime? @map("current_period_end")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  ownedClinics Clinic[]       @relation("OwnedClinics")
  memberships  ClinicMember[]
  auditLogs    AuditLog[]

  @@index([email])
  @@index([supabaseUid])
}

/// Clínica = organización multi-tenant (cada cliente SaaS puede tener 1 o varias)
/// Una clínica puede ser: consultorio privado, centro médico, hospital, etc.
model Clinic {
  id           String   @id @default(cuid())
  ownerId      String   @map("owner_id")
  name         String
  slug         String   @unique
  ruc          String?
  address      String?
  phone        String?
  email        String?
  logoUrl      String?  @map("logo_url")
  currency     String   @default("S/")
  themeColor   String   @default("#0ea5e9") @map("theme_color")
  brandingText String   @default("Gestionado con CitasPro") @map("branding_text")
  isWhiteLabel Boolean  @default(false) @map("is_white_label")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner        User             @relation("OwnedClinics", fields: [ownerId], references: [id], onDelete: Cascade)
  members      ClinicMember[]
  specialties  Specialty[]
  services     Service[]
  doctors      Doctor[]
  patients     Patient[]
  appointments Appointment[]
  schedules    DoctorSchedule[]
  payments     Payment[]
  cashSessions CashSession[]
  medications  Medication[]
  auditLogs    AuditLog[]
  files        PatientFile[]

  @@index([ownerId])
}

/// Membresías de usuarios en clínicas (multi-rol)
model ClinicMember {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  clinicId   String    @map("clinic_id")
  role       String // owner | doctor | receptionist | admin
  invitedAt  DateTime  @default(now()) @map("invited_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([clinicId])
}

// ============================================================
// DOMINIO MÉDICO (extraído del sistema PHP)
// ============================================================

/// Especialidades médicas (Cardiología, Pediatría, etc.)
model Specialty {
  id          String   @id @default(cuid())
  clinicId    String   @map("clinic_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctors       Doctor[]
  interconsults Interconsult[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

/// Servicios médicos (Consulta, Electrocardiograma, etc.) con precio
model Service {
  id          String   @id @default(cuid())
  clinicId    String   @map("clinic_id")
  name        String
  description String?
  price       Float
  durationMin Int      @default(30) @map("duration_min") // duración por defecto en minutos
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

/// Médico vinculado a un usuario y a una clínica
model Doctor {
  id                String   @id @default(cuid())
  clinicId          String   @map("clinic_id")
  userId            String?  @map("user_id")
  specialtyId       String   @map("specialty_id")
  fullName          String   @map("full_name")
  documentId        String?  @map("document_id") // DNI / colegiatura
  colegiatura       String?
  phone             String?
  email             String?
  bio               String?
  consultationPrice Float?   @map("consultation_price")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  clinic       Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  specialty    Specialty        @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  schedules    DoctorSchedule[]
  appointments Appointment[]

  @@index([clinicId])
  @@index([specialtyId])
}

/// Horarios de atención por médico y día de la semana
model DoctorSchedule {
  id           String    @id @default(cuid())
  clinicId     String    @map("clinic_id")
  doctorId     String    @map("doctor_id")
  dayOfWeek    String    @map("day_of_week") // Lunes | Martes | Miércoles | Jueves | Viernes | Sábado | Domingo
  specificDate DateTime? @map("specific_date") // si está seteado, aplica solo a esa fecha
  startTime    String    @map("start_time") // "08:00"
  endTime      String    @map("end_time") // "18:00"
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
  @@index([clinicId])
}

/// Paciente (datos demográficos + historia clínica)
model Patient {
  id                  String    @id @default(cuid())
  clinicId            String    @map("clinic_id")
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  fullName            String    @map("full_name")
  documentType        String?   @map("document_type") // DNI | CE | Pasaporte
  documentId          String?   @map("document_id")
  birthDate           DateTime? @map("birth_date") @db.Timestamptz
  sex                 String? // M | F | Otro
  phone               String?
  email               String?
  address             String?
  bloodType           String?   @map("blood_type") // O+ | O- | A+ | ...
  allergies           String?
  chronicConditions   String?   @map("chronic_conditions")
  medicalHistory      String?   @map("medical_history") // antecedentes
  emergencyContact    String?   @map("emergency_contact")
  emergencyPhone      String?   @map("emergency_phone")
  medicalRecordNumber String?   @map("medical_record_number") // N° historia clínica
  notes               String?
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  files        PatientFile[]

  @@index([clinicId])
  @@index([clinicId, documentId])
  @@index([clinicId, lastName])
}

/// Cita médica + datos de atención clínica (historia)
model Appointment {
  id              String   @id @default(cuid())
  clinicId        String   @map("clinic_id")
  patientId       String   @map("patient_id")
  doctorId        String   @map("doctor_id")
  serviceId       String?  @map("service_id")
  appointmentDate DateTime @map("appointment_date") @db.Timestamptz
  durationMin     Int      @default(30) @map("duration_min")
  reason          String? // motivo de consulta
  status          String   @default("pendiente") // pendiente | confirmada | en_atencion | finalizada | cancelada | no_asistio
  notes           String?

  // ── Signos vitales ──
  weight           Float? // peso (kg)
  height           Float? // talla (cm)
  temperature      Float? // °C
  bloodPressure    String? @map("blood_pressure") // "120/80"
  heartRate        String? @map("heart_rate") // fc
  respiratoryRate  String? @map("respiratory_rate") // fr
  oxygenSaturation String? @map("oxygen_saturation") // sat O2

  // ── Historia clínica ──
  illnessDuration String?   @map("illness_duration") // tiempo de enfermedad
  currentIllness  String?   @map("current_illness") // enfermedad actual
  background      String? // antecedentes
  physicalExam    String?   @map("physical_exam") // examen físico
  auxiliaryExams  String?   @map("auxiliary_exams") // exámenes auxiliares
  diagnosis       String? // diagnóstico
  treatment       String? // tratamiento
  prescription    String? // prescripción
  restDays        Int       @default(0) @map("rest_days")
  restEndDate     DateTime? @map("rest_end_date") @db.Timestamptz
  followUpDate    DateTime? @map("follow_up_date") @db.Timestamptz // fecha de control

  interconsultSpecialtyId String? @map("interconsult_specialty_id") // interconsulta a especialidad

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  payments      Payment[]
  interconsults Interconsult[]

  @@index([clinicId, appointmentDate])
  @@index([doctorId, appointmentDate])
  @@index([patientId])
}

/// Interconsultas derivadas desde una cita
model Interconsult {
  id            String   @id @default(cuid())
  appointmentId String   @map("appointment_id")
  specialtyId   String   @map("specialty_id")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  specialty   Specialty   @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([specialtyId])
}

// ============================================================
// CAJA Y PAGOS
// ============================================================

/// Pago asociado a una cita
model Payment {
  id            String   @id @default(cuid())
  clinicId      String   @map("clinic_id")
  appointmentId String   @map("appointment_id")
  amount        Float
  method        String // efectivo | tarjeta | yape | plin | transferencia
  reference     String?
  notes         String?
  paymentDate   DateTime @default(now()) @map("payment_date") @db.Timestamptz

  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([clinicId, paymentDate])
  @@index([appointmentId])
}

/// Sesión de caja (apertura / cierre) por usuario
model CashSession {
  id             String        @id @default(cuid())
  clinicId       String        @map("clinic_id")
  openedByUserId String        @map("opened_by_user_id")
  openingAmount  Float         @default(0) @map("opening_amount")
  closingAmount  Float?        @map("closing_amount")
  openedAt       DateTime      @default(now()) @map("opened_at") @db.Timestamptz
  closedAt       DateTime?     @map("closed_at") @db.Timestamptz
  status         String        @default("abierta") // abierta | cerrada
  notes          String?
  expenses       CashExpense[]

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
}

/// Gastos registrados durante una sesión de caja
model CashExpense {
  id            String   @id @default(cuid())
  cashSessionId String   @map("cash_session_id")
  description   String
  amount        Float
  expenseDate   DateTime @default(now()) @map("expense_date") @db.Timestamptz

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([cashSessionId])
}

// ============================================================
// INVENTARIO MÉDICO
// ============================================================

/// Medicamentos / insumos
model Medication {
  id             String    @id @default(cuid())
  clinicId       String    @map("clinic_id")
  commercialName String    @map("commercial_name")
  genericName    String?   @map("generic_name")
  presentation   String? // tableta | jarabe | inyectable | ...
  stock          Int       @default(0)
  minStock       Int       @default(5) @map("min_stock")
  unitPrice      Float?    @map("unit_price")
  expiryDate     DateTime? @map("expiry_date") @db.Timestamptz
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, commercialName])
}

// ============================================================
// ARCHIVOS ADJUNTOS DE PACIENTES
// ============================================================

/// Archivos PDF/imágenes subidos a la historia del paciente
/// El archivo vive en Supabase Storage; aquí solo guardamos la URL y metadatos.
model PatientFile {
  id          String   @id @default(cuid())
  clinicId    String   @map("clinic_id")
  patientId   String   @map("patient_id")
  fileName    String   @map("file_name")
  fileUrl     String   @map("file_url") // URL pública o firmada de Supabase Storage
  fileType    String?  @map("file_type") // pdf | jpg | png | ...
  fileSize    Int?     @map("file_size")
  description String?
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([clinicId])
}

// ============================================================
// AUDITORÍA Y SEGURIDAD
// ============================================================

/// Log de auditoría multi-tenant
model AuditLog {
  id          String   @id @default(cuid())
  clinicId    String?  @map("clinic_id")
  userId      String?  @map("user_id")
  action      String // CREATE | UPDATE | DELETE | LOGIN | LOGOUT
  entity      String? // tabla afectada
  entityId    String?  @map("entity_id")
  description String?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([userId])
}
