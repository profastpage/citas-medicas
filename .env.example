# ============================================================
# CitasPro — Variables de entorno
# ============================================================
# Copia este archivo a .env.local y completa los valores.
# En producción, configura estas mismas variables en Vercel.
# ============================================================

# ── Supabase (obligatorias para producción) ──
# Encuéntralas en: Supabase Dashboard → Settings → API
# Region recomendada: São Paulo (sa-east-1) para clientes peruanos

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Solo servidor (NO exponer al cliente):
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ── Prisma / Postgres (Supabase pooler) ──
# Encuéntralas en: Supabase Dashboard → Settings → Database → Connection string
# Usa el pooler (puerto 6543) para DATABASE_URL y el directo (5432) para DIRECT_URL
# Formato: postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

DATABASE_URL=postgresql://postgres.TU-REF:TU-PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.TU-REF:TU-PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ── MercadoPago (suscripciones) ──
# Encuéntralas en: https://www.mercadopago.com.pe/developers/panel/app
MERCADEPAGO_ACCESS_TOKEN=tu-access-token-mp
MERCADEPAGO_PUBLIC_KEY=tu-public-key-mp
MERCADEPAGO_WEBHOOK_SECRET=tu-webhook-secret-mp

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En producción: https://citas-medicas.vercel.app

# ── JWT (legacy — ya no se usa con Supabase Auth, mantener para compat) ──
JWT_SECRET=cambia-esto-en-producion-por-una-cadena-larga-y-aleatoria
